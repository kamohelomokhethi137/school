# ==========================================
# Unity project .gitignore
# Everything here is either regenerated by the Unity editor on open,
# produced by a build, or a duplicate copy of an asset that already
# lives inside Assets/. Nothing tracked is needed to open the project.
# ==========================================

# --- Unity generated folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data for folders Unity recreates
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# --- Unity crash / recovery data ---
sysinfo.txt
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# --- Autogenerated IDE project files (regenerated by Unity on open) ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/.roslyn/

# --- Unity generated meta files for IDE artifacts ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Build output ---
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# --- Project specific: duplicate raw source assets ---
# Raw FBX source dump; identical files are imported in Assets/Person/
/person/

# Downloaded texture packs (zip + extracted) already imported in Assets/Textures/
/TexturesTemp/

# 3ds Max scratch folder
/3ds max file/

# --- OS noise ---
.DS_Store
Thumbs.db
Desktop.ini
